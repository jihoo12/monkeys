# A GitHub token with permission to read the contribution calendar.
# For public contributions only, a classic PAT with `read:user` is enough.
# For private contribution counts, grant the token access to private repos.
# The CLI also accepts MONKEY_TOKEN or GH_TOKEN as fallbacks.
GITHUB_TOKEN=ghp_replace_me

# Optional defaults so you can simply run `npm run generate`
GITHUB_USER=your-github-username
