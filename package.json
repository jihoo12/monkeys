{
  "name": "monkey-civilization",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub contribution-powered pixel-art monkey civilization that evolves in your profile README.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=.env src/cli.ts",
    "generate:demo": "node src/cli.ts --demo --out examples/monkey-civilization.svg",
    "generate:gallery": "node scripts/generate-gallery.ts",
    "check:examples": "npm run generate:demo && npm run generate:gallery && git diff --exit-code -- examples",
    "preview": "node src/preview.ts",
    "test": "node --test tests/*.test.ts",
    "test:action": "node --test tests/action.test.ts",
    "typecheck": "tsc --noEmit",
    "check:svg": "node scripts/check-svg.ts",
    "render:png": "node scripts/render-png.ts examples/monkey-civilization.svg examples/monkey-civilization.png"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
